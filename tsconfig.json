{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["chrome", "vite/client", "node"]
	},
	"include": ["extension/**/*.ts", "extension/**/*.svelte", "vite.config.ts"]
}
