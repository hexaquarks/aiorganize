{
  "manifest_version": 3,
  "name": "AI Organize Groups",
  "version": "0.2.0",
  "description": "Preview AI topic groups for your tabs, then approve to apply. Uses your OpenAI API key directly in Chrome.",
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "minimum_chrome_version": "123",
  "permissions": ["tabs", "tabGroups", "debugger", "sidePanel", "nativeMessaging", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {"default_title": "Organize tabs"},
  "side_panel": {"default_path": "panel.html"},
  "background": {"service_worker": "background.js"}
}
