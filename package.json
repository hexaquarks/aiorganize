{
	"name": "aiorganize",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "vite build --watch --mode development",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write extension 'tests/**/*.{ts,mjs}' vite.config.ts vitest.config.ts svelte.config.js tsconfig.json package.json .prettierrc.json",
		"format:check": "prettier --check extension 'tests/**/*.{ts,mjs}' vite.config.ts vitest.config.ts svelte.config.js tsconfig.json package.json .prettierrc.json",
		"test": "vitest run"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/chrome": "^0.3.5",
		"@types/node": "^26.6.5",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"dependencies": {
		"@langchain/core": "^1.2.17",
		"@langchain/openai": "^1.6.2",
		"http-status-codes": "^2.3.0"
	}
}
